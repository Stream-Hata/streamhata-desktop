{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nameless StreamHata",
  "version": "0.6.35-pre-alpha",
  "identifier": "dev.rdpctd.nameless-streamhata",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Nameless StreamHata",
        "create": false,
        "userAgent": "NamelessStreamHataDesktop/0.1",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "url": "index.html",
        "visible": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1N0E2Q0ExRTI4QkVDOUIKUldTYjdJdmlvV3g2UlgrWUVVcFFSU1U1SVVTTm9SemlSYnU0VDh2bUVhK3htL05DYjNCOUxZSG4K",
      "endpoints": [
        "https://github.com/Stream-Hata/streamhata-desktop/releases/latest/download/latest.json",
        "https://streamhata.rdpctd.dev/desktop/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
